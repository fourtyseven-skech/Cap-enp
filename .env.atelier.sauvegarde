# Fichier local, non versionné (couvert par .gitignore).
# Modèle documenté : .env.example

# Panel d'administration ouvert sur le site construit — pour la phase de test
# sur Netlify. N'importe quel identifiant et un mot de passe d'au moins quatre
# caractères suffisent : le formulaire n'écarte qu'un visiteur de passage.
#
# ⚠️ Ce n'est pas une sécurité — voir l'en-tête de src/admin/auth.ts. À retirer
# (ou remplacer par une vraie authentification, lot 3.1) avant la mise en ligne
# de l'adresse publique.
VITE_ADMIN_AUTH=atelier

# Code d'accès partagé. Laissé vide : aucun code n'est exigé.
VITE_ADMIN_CODE=
