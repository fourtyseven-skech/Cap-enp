# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

node_modules
dist
dist-ssr
*.local

# Editor directories and files
.vscode/*
!.vscode/extensions.json
.idea
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# Variables d'environnement locales — ne jamais versionner.
# `.env.example` sert de modèle et reste, lui, dans le dépôt.
.env
.env.local
.env.*.local

# Configuration réelle du serveur du panel — jamais versionnée.
# `serveur/.env.example` sert de modèle et reste, lui, dans le dépôt.
serveur/.env

# Médias recopiés depuis la base au moment du build (dossier dérivé).
# La base fait foi ; voir scripts/exporter-medias.mjs
public/medias/

# Manifeste écrit par scripts/exporter-contenu.mjs : dérivé, non versionné.
content/accueil/.genere-depuis-la-base.json

# Profil de navigateur et copies de recette.
.chrome-editeur/
.chrome-fiche/
content/accueil/.*.recette

# Outils de construction : gabarit vierge conservé entre deux constructions.
.cache-build/
