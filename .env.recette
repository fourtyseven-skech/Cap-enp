# ---------------------------------------------------------------------------
# Mode « recette » — chargé uniquement par `npm run dev -- --mode recette`.
#
# Sert à la recette navigateur du panel (serveur/src/outils/recette-panel.ts),
# qui démarre une vraie base, une vraie API, puis pilote un navigateur.
#
# Aucun secret ici : les deux adresses sont locales et les ports sont fixes,
# pour que le script et le fichier restent d'accord.
# ---------------------------------------------------------------------------

# Le panel parle au serveur au lieu d'écrire dans le navigateur.
VITE_API_URL=http://localhost:3999

# Authentification réelle : e-mail et mot de passe vérifiés par l'API.
VITE_ADMIN_AUTH=serveur

# Le panel doit être présent, y compris si le mode change un jour le défaut.
VITE_AVEC_PANEL=1
