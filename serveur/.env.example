# ===========================================================================
#  MEGASOFT — CONFIGURATION DU SERVEUR DU PANEL
# ===========================================================================
#
#  ÉTAT : PRÉPARATION — toutes les valeurs ci-dessous sont GÉNÉRIQUES.
#
#  Aucune n'est réelle. Chacune est marquée « À REMPLACER » avec l'indication
#  de qui doit la fournir. Copier ce fichier en `serveur/.env` le jour de la
#  mise en service et remplacer les valeurs, sans jamais versionner le résultat.
#
#  Ce fichier-ci reste dans le dépôt : il sert de modèle et de liste de
#  contrôle. Il ne doit donc jamais contenir de valeur réelle.
# ===========================================================================


# ---------------------------------------------------------------------------
#  BASE DE DONNÉES — PostgreSQL
#  À REMPLACER — à demander au client (hébergeur de la base)
# ---------------------------------------------------------------------------

# Forme complète, la plus simple à transmettre :
#   postgres://UTILISATEUR:MOT_DE_PASSE@HOTE:PORT/BASE
#
# Le compte utilisé doit être le compte APPLICATIF restreint créé à la fin de
# schema.sql, jamais le propriétaire de la base ni un superutilisateur.
DATABASE_URL=postgres://megasoft_app:mot_de_passe_a_definir@localhost:5432/megasoft_panel

# Chiffrement de la connexion. `require` dès que la base n'est pas sur la même
# machine que le serveur applicatif — sans quoi les mots de passe des sessions
# circulent en clair sur le réseau du client.
#   disable  → uniquement pour une base locale de développement
#   require  → valeur attendue en production
PGSSLMODE=require


# ---------------------------------------------------------------------------
#  SESSIONS ET MOTS DE PASSE
#  À GÉNÉRER par vous, pas à demander au client
# ---------------------------------------------------------------------------

# Clé de signature des cookies de session.
# À REMPLACER par une chaîne aléatoire d'au moins 32 caractères :
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
#
# Changer cette clé déconnecte tout le monde — c'est d'ailleurs le moyen le
# plus rapide de fermer l'accès en cas d'incident.
SECRET_SESSION=a_generer_avant_la_mise_en_service

# Durée d'une session, en heures. 12 h couvre une journée de travail sans
# obliger à se reconnecter après le déjeuner.
DUREE_SESSION_H=12

# Coût bcrypt. 12 est le réglage courant en 2026 : environ 250 ms par
# vérification, assez lent pour décourager une attaque par force brute, assez
# rapide pour ne pas se voir à la connexion.
COUT_BCRYPT=12


# ---------------------------------------------------------------------------
#  ORIGINE AUTORISÉE
#  À REMPLACER — dépend du domaine retenu pour le panel
# ---------------------------------------------------------------------------

# Seule origine autorisée à appeler l'API — l'adresse d'où le panel est servi.
# Le navigateur refusera toute autre provenance. Ne JAMAIS mettre `*` : le
# cookie de session partirait alors vers n'importe quel site qui en ferait la
# demande.
ORIGINE_AUTORISEE=https://admin.megasoft-office.com

# En développement local, ajouter l'adresse du serveur Vite :
# ORIGINE_AUTORISEE=http://localhost:8080


# ---------------------------------------------------------------------------
#  STOCKAGE DES MÉDIAS
#  À REMPLACER — à décider avec le client
# ---------------------------------------------------------------------------

# Ne concerne QUE les vidéos et les PDF : les images sont converties en WebP et
# stockées dans la base, hors de portée de ce réglage.
#
# `disque` → dossier du serveur PlanetHoster. C'est le cas retenu.
# `s3`     → stockage d'objets, non utilisé pour l'instant.
STOCKAGE_MEDIAS=disque

# Si STOCKAGE_MEDIAS=disque
CHEMIN_MEDIAS=/var/www/megasoft/medias

# Si STOCKAGE_MEDIAS=s3 — à REMPLACER par les accès du client
S3_ENDPOINT=
S3_REGION=
S3_BUCKET=
S3_CLE=
S3_SECRET=

# Poids maximal d'un fichier, en mégaoctets. Garde-fou de performance autant
# que de stockage : une image de 8 Mo détruirait le LCP du site.
POIDS_MAX_MO=25


# ---------------------------------------------------------------------------
#  RECONSTRUCTION DU SITE
#  À REMPLACER — chemin du site sur le serveur PlanetHoster
# ---------------------------------------------------------------------------

# Le site est hébergé chez PlanetHoster, sur le serveur du client. Publier
# depuis le panel relance donc la construction SUR PLACE : le panneau N0C donne
# un accès SSH avec Node et npm, aucun service tiers n'intervient.
#
# La commande est lancée dans REPERTOIRE_SITE. Elle ne doit PAS inclure
# `git pull` : le dépôt n'est pas déployé par Git, les sources sont déjà sur le
# serveur.
#
# ⚠️ PAS de `--omit=dev`. La construction d'un site statique a besoin d'outils
# qui sont, par nature, des dépendances de développement : vite, typescript,
# sharp (images) et pg (lecture de la base par les ponts). Avec `--omit=dev`,
# la commande échoue à la première publication — vérifié, ce n'est pas une
# précaution théorique. Le poids installé reste sur le serveur, pas sur le site
# livré au visiteur.
COMMANDE_RECONSTRUCTION=npm ci && npm run build

# Dossier du site sur le serveur — celui qui contient package.json.
REPERTOIRE_SITE=/home/compte/megasoft-site

# Délai avant de considérer une reconstruction comme échouée, en minutes.
DELAI_RECONSTRUCTION_MIN=10


# ---------------------------------------------------------------------------
#  COURRIELS — FACULTATIF
# ---------------------------------------------------------------------------
#
# Sans SMTP_HOTE, le panel fonctionne entièrement : à la création d'un compte,
# le mot de passe provisoire s'affiche à l'écran et l'administrateur le
# transmet lui-même. Renseigner ces lignes ajoute UNE commodité, et une seule :
# l'invitation part directement à la personne concernée.
#
# Il n'y a pas de « mot de passe oublié » — un panel d'administration ne se
# récupère pas par courriel. Un compte qui perd son mot de passe est repris en
# main par un administrateur, en base.
#
# Chez PlanetHoster, une adresse du domaine convient (webmail N0C).

# SMTP_HOTE=mail.megasoft-office.com
# SMTP_PORT=587
# SMTP_UTILISATEUR=panel@megasoft-office.com
# SMTP_MOTDEPASSE=
# SMTP_EXPEDITEUR=Administration Megasoft <panel@megasoft-office.com>

# Adresse publique du panel, reprise dans le courriel d'invitation. Sans elle,
# ORIGINE_AUTORISEE sert de repli — ce qui convient si le panel est servi sous
# le même domaine.
# ADRESSE_PANEL=https://admin.megasoft-office.com


# ---------------------------------------------------------------------------
#  DIVERS
# ---------------------------------------------------------------------------

# Port d'écoute du serveur applicatif.
PORT=3000

# `production` en ligne. En `developpement`, les messages d'erreur sont
# détaillés — ce qui ne doit jamais être le cas face à un visiteur.
ENVIRONNEMENT=developpement
